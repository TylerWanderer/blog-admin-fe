# Copy to .env.development.local (gitignored) and fill in.

# Where the Vite dev server forwards /api requests (see vite.config.js).
# The ECS service URL, from the ECS console (service > Express Mode URL),
# or http://localhost:8000 for an API running locally with uvicorn.
API_PROXY_TARGET=https://<your-service>.ecs.ap-southeast-1.on.aws

# Cognito user pool and app client (Cognito console > User pools).
# Not secrets: they are bundled into the browser code by design.
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
VITE_COGNITO_USER_POOL_CLIENT_ID=<app client id>
